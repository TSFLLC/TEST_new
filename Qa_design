1. Check who has broad access

SELECT 
    dp1.name AS DatabaseRole,
    dp2.name AS MemberName
FROM sys.database_role_members drm
JOIN sys.database_principals dp1 
    ON drm.role_principal_id = dp1.principal_id
JOIN sys.database_principals dp2 
    ON drm.member_principal_id = dp2.principal_id
WHERE dp1.name IN ('db_datareader', 'db_datawriter')
ORDER BY dp1.name, dp2.name;



++++++++++++++2.deny broad access to those 4 tables and create a separate restricted role just for approved users + one service account++++++++++++++
0-- 1. Create restricted role
CREATE ROLE TERA_Restricted4Tables_RW;
GO

-- 2. Add only approved AD group/user and service account
ALTER ROLE TERA_Restricted4Tables_RW 
ADD MEMBER [DOMAIN\Approved_AD_Group];

ALTER ROLE TERA_Restricted4Tables_RW 
ADD MEMBER [DOMAIN\ServiceAccountName];
GO

-- 3. Grant access only to the 4 tables
GRANT SELECT, INSERT, UPDATE, DELETE ON OBJECT::SchemaName.Table1 TO TERA_Restricted4Tables_RW;
GRANT SELECT, INSERT, UPDATE, DELETE ON OBJECT::SchemaName.Table2 TO TERA_Restricted4Tables_RW;
GRANT SELECT, INSERT, UPDATE, DELETE ON OBJECT::SchemaName.Table3 TO TERA_Restricted4Tables_RW;
GRANT SELECT, INSERT, UPDATE, DELETE ON OBJECT::SchemaName.Table4 TO TERA_Restricted4Tables_RW;
GO



++++++++++++++///
Then block everyone else who currently gets broad read access:+++++++++++++++++///

DENY SELECT ON OBJECT::SchemaName.Table1 TO db_datareader;
DENY SELECT ON OBJECT::SchemaName.Table2 TO db_datareader;
DENY SELECT ON OBJECT::SchemaName.Table3 TO db_datareader;
DENY SELECT ON OBJECT::SchemaName.Table4 TO db_datareader;
GO


